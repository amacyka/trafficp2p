TELEGRAM_BOT_TOKEN=

# Use the current official xRocket API base URL.
# Verify the URL in the xRocket API documentation before running.
XRocket_API_BASE_URL=https://exchange.api.xrocket.com

# Trading pair used by the MVP.
# Adjust to the exact symbol format returned by the current API.
SYMBOL=TON/USDT

# Polling interval for REST collection.
COLLECT_INTERVAL_SECONDS=10

# PostgreSQL
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
DATABASE_URL=postgresql+asyncpg://analytics:analytics@postgres:5432/analytics
